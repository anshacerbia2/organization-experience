# Copy to .env beside this file for a local run of the BFF. .env is git-ignored; never commit it.
# Every variable is described in TDD-identity-experience-001 §Configuration, under this application's
# ORGANIZATION_EXPERIENCE_ prefix. The BFF reads its environment and nothing else: export these
# before `pnpm dev:bff`, which runs in bff/, so relative paths are relative to bff/.

# The BFF on this machine, at http://127.0.0.1:8091: not the identity BFF's 8090, so both run at once.
# The redirect URI is this origin's /auth/callback, exactly as the client is registered
# (deploy/dev/README.md).
ORGANIZATION_EXPERIENCE_PUBLIC_ORIGIN=http://127.0.0.1:8091
ORGANIZATION_EXPERIENCE_LISTEN_HOST=127.0.0.1
ORGANIZATION_EXPERIENCE_LISTEN_PORT=8091
ORGANIZATION_EXPERIENCE_REDIRECT_URI=http://127.0.0.1:8091/auth/callback

# The built application, `pnpm build` makes it.
ORGANIZATION_EXPERIENCE_WEB_ROOT=../apps/admin/dist

# The development kernel's public issuer, exactly as its discovery document states it.
ORGANIZATION_EXPERIENCE_ISSUER=https://gqr8l4jz-8080.asse.devtunnels.ms/realms/scnehaux

# The client identity-control registered for this BFF (deploy/dev/README.md).
ORGANIZATION_EXPERIENCE_CLIENT_ID=organization-experience-bff

# The BFF's private key, made on this machine by `node scripts/new-client-key.mjs`. The client has
# no secret: it authenticates with this key by signed JWT, and the server holds only the public half.
# Never copy this file anywhere else.
ORGANIZATION_EXPERIENCE_CLIENT_KEY_FILE=../keys/organization-experience-bff.pem

# A database the session store's migrations have been applied to, as the serving role
# (`pnpm --filter @organization-experience/bff migrate`; deploy/dev/README.md).
ORGANIZATION_EXPERIENCE_DATABASE_URL=postgres://organization:organization@localhost:5432/postgres?options=-c%20search_path%3Dorganization_experience_dev

# Where organization-control listens on this machine, for /api/*. Sign-in works without it; the
# proxied calls answer 503 until it runs.
ORGANIZATION_EXPERIENCE_ORGANIZATION_CONTROL_URL=http://127.0.0.1:8099

# Provider mode's bounds (TDD-organization-experience-001 §Configuration). Unset, these defaults apply.
# ORGANIZATION_EXPERIENCE_PROVIDER_MAX_DURATION=60m
# ORGANIZATION_EXPERIENCE_PROVIDER_DEFAULT_DURATION=15m
# ORGANIZATION_EXPERIENCE_PROVIDER_STEP_UP_AGE=5m

# 32 random bytes, base64, made once on this machine and kept, so sessions survive a restart:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
ORGANIZATION_EXPERIENCE_SESSION_KEY=
